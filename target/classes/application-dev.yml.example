# 开发环境数据库配置示例
# 复制此文件为 application-dev.yml 并修改为新数据库信息

spring:
    datasource:
        # MySQL 配置示例
        driverClassName: com.mysql.cj.jdbc.Driver
        url: jdbc:mysql://localhost:3306/新数据库名?useUnicode=true&characterEncoding=utf-8&useJDBCCompliantTimezoneShift=true&useLegacyDatetimeCode=false&serverTimezone=GMT%2B8&useSSL=false
        username: 新用户名
        password: 新密码
        
        # SQL Server 配置示例（如需要，取消注释并修改）
        # driverClassName: com.microsoft.sqlserver.jdbc.SQLServerDriver
        # url: jdbc:sqlserver://localhost:1433;DatabaseName=新数据库名
        # username: 新用户名
        # password: 新密码
